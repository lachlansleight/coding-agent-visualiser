{
  "env": {
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:4517"
  },
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "http", "url": "http://127.0.0.1:4517/hook", "timeout": 2 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "http", "url": "http://127.0.0.1:4517/hook", "timeout": 2 }] }],
    "PreToolUse": [{ "matcher": "*", "hooks": [{ "type": "http", "url": "http://127.0.0.1:4517/hook", "timeout": 2 }] }],
    "PostToolUse": [{ "matcher": "*", "hooks": [{ "type": "http", "url": "http://127.0.0.1:4517/hook", "timeout": 2 }] }],
    "PostToolUseFailure": [{ "matcher": "*", "hooks": [{ "type": "http", "url": "http://127.0.0.1:4517/hook", "timeout": 2 }] }],
    "Notification": [{ "hooks": [{ "type": "http", "url": "http://127.0.0.1:4517/hook", "timeout": 2 }] }],
    "SubagentStart": [{ "hooks": [{ "type": "http", "url": "http://127.0.0.1:4517/hook", "timeout": 2 }] }],
    "SubagentStop": [{ "hooks": [{ "type": "http", "url": "http://127.0.0.1:4517/hook", "timeout": 2 }] }],
    "Stop": [{ "hooks": [{ "type": "http", "url": "http://127.0.0.1:4517/hook", "timeout": 2 }] }],
    "PreCompact": [{ "hooks": [{ "type": "http", "url": "http://127.0.0.1:4517/hook", "timeout": 2 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "http", "url": "http://127.0.0.1:4517/hook", "timeout": 2 }] }]
  }
}
